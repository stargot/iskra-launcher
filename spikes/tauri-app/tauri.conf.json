{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wrc-spike",
  "version": "0.1.0",
  "identifier": "dev.wrc.spike",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "wrc spike",
        "width": 720,
        "height": 480,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
